{
  "name": "dsh-better-ask-user",
  "version": "0.1.2",
  "description": "Independent ask_user_question plugin: configurable wait, input-extended countdown, markdown/mobile card, native or default timeout behavior, and PTC deadline exemption.",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Menghuan1918/dsh-better-ask-user.git"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "pretest": "node scripts/build-client.mjs",
    "test": "node --test",
    "build": "node scripts/build-client.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "dsh-better-ptc": "0.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-user-questions": ">=0.2.1-rc.2 <0.3.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "js-yaml": "^4.2.0",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "src",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ]
}
